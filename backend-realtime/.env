# Node.js Realtime Backend
PORT=3276
CORS_ORIGIN=https://scraping.berita.qbyte.web.id,http://localhost:3000
# Model yang dipakai (sama persis dengan Python backend)
EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# Delay antar request scraping (ms)
SCRAPE_DELAY_MS=1000
# Max artikel per sumber saat realtime
MAX_ARTICLES_PER_SOURCE=10